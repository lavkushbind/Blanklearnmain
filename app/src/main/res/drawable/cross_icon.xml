<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="24dp" android:height="24dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
<!--                <size android:width="2dp" android:height="10%" />-->
                <solid android:color="#FF0000" /> <!-- Adjust color -->
            </shape>
        </rotate>
    </item>
    <item>
        <rotate
            android:fromDegrees="-45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
<!--                <size android:width="2dp" android:height="100%" />-->
                <solid android:color="#FF0000" /> <!-- Adjust color -->
            </shape>
        </rotate>
    </item>
</layer-list>
