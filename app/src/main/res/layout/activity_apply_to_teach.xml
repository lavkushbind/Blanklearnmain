<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D1C"
    android:scrollbars="none"

    android:fillViewport="true" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- =================================================================== -->
        <!-- ============== START: BLANKLEARN INTRODUCTION SECTION ============== -->
        <!-- =================================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background2"
            android:padding="5dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- App Logo - Use your actual logo here -->
                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/background_logo"
                    android:contentDescription="Blanklearn Logo" />

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Blanklearn"
                    android:textColor="@color/white"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tv_tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="Unlock Your Child's Potential. Empower Learning Journeys."
                    android:textAlignment="center"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="#33FFFFFF" /> <!-- More subtle white divider -->

            <!-- Mission Statement Section -->
            <TextView
                android:id="@+id/tv_mission_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="OUR MISSION"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tv_mission_statement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="To connect skilled, passionate, and thoroughly vetted educators with students who need personalized academic support—empowering them to excel in school and build lifelong confidence. Our platform is specially designed for busy parents who struggle to find time for after-school learning and homework help. We provide live, small-group or 1-on-1 online sessions that fit seamlessly into family schedules, ensuring every child receives the focused attention they deserve—even when parents can't always be there."
                android:textColor="@color/white"
                android:textSize="15sp" />

            <!-- Key Features Section -->
            <TextView
                android:id="@+id/tv_features_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="WHY CHOOSE US?"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp"
                android:letterSpacing="0.05"/>

            <!-- Feature 1: Expert Tutors -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/button_bg"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Vetted and Certified US Educators"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Feature 2: Personalized Learning -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/bg_button_selector"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Custom Learning Plans and Progress Tracking"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Feature 3: Flexible Scheduling -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/card_background"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Flexible Scheduling for Busy Families"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Call to Action Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_explore_tutors"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_bg"
                android:text="Explore Tutors and Programs"
                android:textColor="@color/background"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"/>

        </LinearLayout>        <!-- ============== END: BLANKLEARN INTRODUCTION SECTION ============== -->


        <!-- =================================================================== -->
        <!-- ======================= START: STEPPER VIEW ======================= -->
        <!-- =================================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Step 1 of 3: Basic Information"
                android:textColor="#FF9800"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Step 1: Active -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/button_bg"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Info"
                        android:textColor="#FF9800"
                        android:textSize="12sp"/>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="#4A4A4A" />

                <!-- Step 2: Inactive -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/button_bg"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#9E9E9E"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Verification"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"/>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="#4A4A4A" />

                <!-- Step 3: Inactive -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/button_bg"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#9E9E9E"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Onboarding"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <!-- ======================== END: STEPPER VIEW ======================== -->


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="Teacher Application"
            android:textColor="#FF9800"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Basic Information Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/folded_corner"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext_custom"
                android:inputType="textPersonName|textCapWords"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Experience Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Years of Teaching Experience"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_experience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext_custom"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Past Institutes Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Past Institutes or Platforms"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_institutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext_custom"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:lines="3"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- NEW: Resume Upload Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_container_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Resume (PDF only)"
                android:textColor="#FF9800"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_select_resume"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/folded_corner"

                android:padding="12dp"
                android:text="Select PDF File"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tv_selected_file_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No file selected."
                android:textColor="#B0B0B0"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="my_professional_resume.pdf"/>
        </LinearLayout>


        <!-- Technical Setup Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_container_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technical Setup"
                android:textColor="#FF9800"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Device Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Primary Teaching Device"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rg_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_laptop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Laptop" android:textColor="@color/white" />
                <RadioButton android:id="@+id/rb_desktop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Desktop" android:textColor="@color/white" />
                <RadioButton android:id="@+id/rb_tablet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tablet" android:textColor="@color/white" />
            </RadioGroup>

            <!-- Tools Familiarity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Familiar Teaching Tools"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <CheckBox android:id="@+id/cb_zoom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zoom" android:textColor="@color/white"/>
            <CheckBox android:id="@+id/cb_meet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Google Meet" android:textColor="@color/white"/>
            <CheckBox android:id="@+id/cb_teams" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Microsoft Teams" android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Video Link Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_container_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Link to Introduction Video (Optional)"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_video_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext_custom"
                android:inputType="textUri"
                android:hint="https://..."
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="#808080"
                android:textSize="16sp" />
        </LinearLayout>


        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/button_bg2"
            android:layout_gravity="center"
            android:text="Submit Application"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>


</ScrollView>