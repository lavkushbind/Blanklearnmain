            <!-- ADD this new MaterialCardView in its place -->
            <com.google.android.material.card.MaterialCardView

                android:id="@+id/poster"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/postnow"

                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardPreventCornerOverlap="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/quest_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/quest_card_background"
                    android:padding="16dp">

                    <!-- Animated Icon (Lottie) -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_quest_icon"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/brain"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Dynamic Title -->
                    <TextView
                        android:id="@+id/tv_quest_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/lottie_quest_icon"
                        app:layout_constraintTop_toTopOf="@id/lottie_quest_icon"
                        tools:text="Wildlife Wednesday" />

                    <!-- Social Proof -->
                    <TextView
                        android:id="@+id/tv_community_metric"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.8"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/tv_quest_title"
                        app:layout_constraintStart_toStartOf="@id/tv_quest_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_quest_title"
                        tools:text="54,123 students have started!" />

                    <!-- CTA Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_begin_quest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Begin Your Quest!"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        app:backgroundTint="@android:color/white"
                        app:cornerRadius="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:rippleColor="#6A11CB"
                        android:textColor="#6A11CB" />

                    <!-- Streak Counter Group -->
                    <LinearLayout
                        android:id="@+id/layout_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toTopOf="@id/btn_begin_quest"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/iv_streak_flame"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_flame_large"
                            app:tint="@android:color/white" />

                        <TextView
                            android:id="@+id/tv_streak_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            tools:text="15 Day Streak" />

                        <ImageView
                            android:id="@+id/iv_streak_freeze"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_streak_freeze"
                            android:visibility="gone"
                            tools:visibility="visible"
                            app:tint="@android:color/white" />
                    </LinearLayout>

                    <!-- Countdown Timer -->
                    <TextView
                        android:id="@+id/tv_countdown_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFC107"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/layout_streak"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/layout_streak"
                        tools:text="Ends in 14:32:15" />

                    <!-- Completed State Overlay -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/completed_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="#99000000"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:visibility="visible" >

                        <ImageView
                            android:id="@+id/iv_completed_check"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@android:color/white"
                            app:layout_constraintBottom_toTopOf="@id/tv_completed_text"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/tv_completed_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Quest Complete! \nCome back tomorrow."
                            android:textAlignment="center"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_completed_check" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>



