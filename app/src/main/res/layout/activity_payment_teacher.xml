<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#0B0E1E">

    <!-- Header Section -->
    <TextView
        android:id="@+id/headerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:text="Get Students in 48 hours with Blanklearn."
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Plan Options Section -->
    <RadioGroup
        android:id="@+id/planGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerText">

        <!-- Basic Plan -->
        <RadioButton
            android:id="@+id/basicPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="300"
            android:text="Basic - ₹299 / month" />

        <!-- Starter Plan -->
        <RadioButton
            android:id="@+id/starterPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="500"
            android:text="Starter - ₹499 / month" />

        <!-- Pro Plan -->
        <RadioButton
            android:id="@+id/proPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="1000"
            android:text="Pro - ₹999 / month" />
    </RadioGroup>

    <!-- Plan Details Section -->
    <LinearLayout
        android:id="@+id/planDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/planGroup">

        <TextView
            android:id="@+id/planDetailsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Plan Details"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/planBenefits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Benefits:\n1. Personalized mentoring\n2. Limited seats (5-20 students)\n3. 1-hour live classes every day" />

        <TextView
            android:id="@+id/planDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Duration: 30 days per subscription" />
    </LinearLayout>

    <!-- How It Works Section -->
    <TextView
        android:id="@+id/howItWorks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="How It Works"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/planDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/howItWorksDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1. Choose your plan\n2. Make payment\n3. Get started with live classes\n4. Get personalized support from teachers"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/howItWorks"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Payment Button -->
    <Button
        android:id="@+id/btn_pay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Proceed to Payment"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/howItWorksDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
