<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp" >

    <TextView
        android:id="@+id/header_text_subjects"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Which subjects need the most attention?"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/body_text_subjects"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="You can select more than one."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_text_subjects" />

    <!-- सब्जेक्ट्स के लिए ChipGroup -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_subjects"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/body_text_subjects">

        <!-- यहाँ सब्जेक्ट चिप्स बनाएँ -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_maths"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maths"
            app:chipIcon="@drawable/background_logo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_science"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Science"
            app:chipIcon="@drawable/background_logo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_english"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="English"
            app:chipIcon="@drawable/background_logo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_social_studies"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Social Studies"
            app:chipIcon="@drawable/background_logo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_hindi"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hindi"
            app:chipIcon="@drawable/background_logo" />

    </com.google.android.material.chip.ChipGroup>

    <Button
        android:id="@+id/btn_next_subjects"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:enabled="false"
        android:text="Next"
        android:textSize="16sp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>