<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp" >

    <!-- My Results Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Session Results"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/myFocusPercentageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Focus Level: 85%"/>

            <TextView
                android:id="@+id/myDistractionTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Time Distracted: 4s"/>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/myFocusChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Partner Results Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/partnerResultsCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partner's Session Results"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/partnerFocusPercentageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Focus Level: 70%"/>

            <TextView
                android:id="@+id/partnerDistractionTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Time Distracted: 9s"/>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/partnerFocusChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/doneButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Done"/>

</LinearLayout>